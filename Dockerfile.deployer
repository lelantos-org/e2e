# syntax=docker/dockerfile:1.7
# Deployer image. Foundry + cast. Runs forge script Deploy.s.sol against
# anvil; emits KEY=value lines on stdout that extract-addresses.sh greps.
#
# Build context MUST be the repo root.
#
#   docker build -f e2e/Dockerfile.deployer -t lelantos/deployer:dev .

FROM ghcr.io/foundry-rs/foundry:stable AS deployer

USER root
WORKDIR /work

# Submodules are already vendored under contracts/lib/* (see .gitmodules).
# We do NOT run `forge install` here — it would try to git-clone over the
# network. The COPY brings the lib/ tree as-is. forge will compile lazily
# on first script invocation.
COPY contracts/ /work/contracts/

WORKDIR /work/contracts

ENTRYPOINT ["/bin/sh", "-c"]
# Default command: deploy and print addresses. Override RPC_URL and
# DEPLOYER_KEY at run time.
#   docker run -e RPC_URL=http://anvil:8545 -e DEPLOYER_KEY=0xac… deployer
CMD ["forge script script/Deploy.s.sol --rpc-url \"$RPC_URL\" --private-key \"$DEPLOYER_KEY\" --broadcast --disable-code-size-limit"]
